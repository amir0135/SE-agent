# SE-Agent environment configuration (copy to .env; never commit real values)

# --- Dynamics CRM / MSX ---
SEAGENT_CRM_URL=https://your-org.crm.dynamics.com
SEAGENT_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
SEAGENT_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Optional: app-only (client credentials) flow. Leave unset for delegated/device-code.
SEAGENT_ENTRA_CLIENT_SECRET=

# --- Language model ---
# Provider: azure-openai | openai
SEAGENT_LLM_PROVIDER=azure-openai
SEAGENT_LLM_ENDPOINT=https://your-resource.openai.azure.com
SEAGENT_LLM_API_KEY=
SEAGENT_LLM_DEPLOYMENT=gpt-4o

# --- Behavior ---
# Force dry mode regardless of other config: 1 to enable.
SEAGENT_DRY_RUN=
